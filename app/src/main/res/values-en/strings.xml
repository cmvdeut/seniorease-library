    <!-- Privacy Policy -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_app_name">SeniorEase Library – Privacy Policy</string>
    <string name="privacy_policy_last_updated">Last updated: 1 October 2025</string>
    <string name="privacy_policy_section_1_title">1. Introduction</string>
    <string name="privacy_policy_section_1_text">Welcome to SeniorEase Library, an app for managing your personal collection of books, music, DVDs and games. This privacy policy explains how we collect, use and protect your data.</string>
    <string name="privacy_policy_section_2_title">2. Data we collect</string>
    <string name="privacy_policy_section_2_text">• Titles of books, music, DVDs and games\n• Author and artist names\n• Barcodes (ISBN, UPC, etc.)\n• Item status (read/listened, owned)\n• Language and medium information\n• Cover images</string>
    <string name="privacy_policy_section_3_title">3. Camera access</string>
    <string name="privacy_policy_section_3_text">The app requests camera access to scan barcodes. This is only used for:\n• Scanning barcodes on your items\n• Automatically retrieving item information\n\nImportant: We do not store camera images. The camera is only used for real-time barcode scanning.</string>
    <string name="privacy_policy_section_4_title">4. Data storage</string>
    <string name="privacy_policy_section_4_text">All data is stored locally on your device in a secure database. We do not send data to external servers, except to retrieve item information via public APIs.</string>
    <string name="privacy_policy_section_5_title">5. Your rights</string>
    <string name="privacy_policy_section_5_text">You have the right to:\n• View and edit your data\n• Delete items from your collection\n• Uninstall the app (this deletes all local data)\n• Deny camera access (barcode scanning will not work)</string>
    <string name="privacy_policy_section_6_title">6. Contact</string>
    <string name="privacy_policy_section_6_text">If you have questions about this privacy policy or the app, please contact us at:\nEmail: info@seniorease.eu\nOrganisation: SeniorEase\nLocation: The Netherlands</string>

