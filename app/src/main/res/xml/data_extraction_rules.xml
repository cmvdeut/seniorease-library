<?xml version="1.0" encoding="utf-8"?>
<!--
  Do not back up premium flag / app prefs — premium must come from Play Billing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
