{
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {"key": "Content-Type", "value": "application/vnd.android.package-archive"},
        {"key": "Content-Disposition", "value": "attachment"}
      ]
    }
  ],
  "redirects": [
    {"source": "/(.*)", "has": [{"type": "host", "value": "www.seniorease.eu"}], "destination": "https://seniorease.eu/$1", "permanent": true},
    {"source": "/", "has": [{"type": "header", "key": "x-vercel-ip-country", "value": "NL"}], "destination": "/nl/", "permanent": false},
    {"source": "/", "has": [{"type": "header", "key": "x-vercel-ip-country", "value": "BE"}], "destination": "/nl/", "permanent": false},
    {"source": "/privacy-policy", "destination": "/privacy-policy.html", "permanent": true},
    {"source": "/tiktok-callback", "destination": "/tiktok-callback.html", "permanent": true}
  ]
}
