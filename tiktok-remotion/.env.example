# TikTok API credentials voor @seniorease
# Zie TIKTOK-SETUP.md voor stap-voor-stap instructies

# Verkregen via OAuth flow (geldig 24 uur, daarna refresh nodig)
TIKTOK_ACCESS_TOKEN=

# Voor het vernieuwen van de access token (geldig 365 dagen)
TIKTOK_REFRESH_TOKEN=

# Van je TikTok Developer app (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Blotato (planning + publish) — https://my.blotato.com
BLOTATO_API_KEY=

# Account IDs per merk (verplicht voor correcte routing)
BLOTATO_SENIOREASE_TIKTOK_ID=27720
BLOTATO_SENIOREASE_INSTAGRAM_ID=50066
BLOTATO_SHELFIEASE_TIKTOK_ID=44442
BLOTATO_SHELFIEASE_INSTAGRAM_ID=50003
# Pad naar ShelfieEase MP4's (als je opnieuw rendert); leeg laten = gebruik media_url / blotato-media-urls-shelfieease.json
BLOTATO_SHELFIEASE_VIDEOS_DIR=C:/Projects/shelfieease-booktok-mvp/public/videos

# Fallback usernames (optioneel)
BLOTATO_TIKTOK_USERNAME=seniorease
BLOTATO_INSTAGRAM_USERNAME=seniorease.library
BLOTATO_SHELFIEASE_TIKTOK_USERNAME=shelfieease
BLOTATO_SHELFIEASE_INSTAGRAM_USERNAME=shelfieease
BLOTATO_FACEBOOK_ACCOUNT_ID=
BLOTATO_FACEBOOK_PAGE_ID=
BLOTATO_FACEBOOK_FULLNAME=Senior Ease
BLOTATO_LINKEDIN_ID=23975
# Zet op false om alleen content te genereren zonder Blotato in te plannen
BLOTATO_DAILY_SCHEDULE=true
# Zet op false om Remotion render over te slaan (GitHub Actions doet dit automatisch)
DAILY_RENDER=true

# Daily content agent (npm run agent:daily) — ook via GitHub Actions
ANTHROPIC_API_KEY=
GMAIL_FROM=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# Instagram / Meta Graph API credentials
# Zie: https://developers.facebook.com/docs/instagram-api/getting-started
# Vereist: Facebook Business account + Instagram Professional account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
